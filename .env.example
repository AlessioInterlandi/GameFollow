PORT=3000
SESSION_SECRET=metti-qui-una-stringa-lunga-e-casuale

# Quale database usare: 'sqlite' oppure 'supabase'
DB_DRIVER=sqlite

# --- se DB_DRIVER=sqlite ---
SQLITE_FILE=./data/app.db

# --- se DB_DRIVER=supabase ---
# URL e chiavi si trovano nella dashboard, in Project Settings > API
SUPABASE_URL=
# chiave pubblica: puo' arrivare al browser, e' limitata dalle RLS
SUPABASE_ANON_KEY=
# chiave privata: SCAVALCA LE RLS. Solo backend, mai nel frontend, mai su git.
SUPABASE_SERVICE_KEY=

# AI: 'mock' non chiama nessuna API e non costa niente.
# Alternative: 'openai' | 'anthropic'
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=

# n8n: lascia vuoto e i workflow vengono simulati.
N8N_WEBHOOK_URL=e3a12fb5-b926-4e15-a76e-f1cabe8cd20a
