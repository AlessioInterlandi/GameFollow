PORT=3000
SESSION_SECRET=metti-qui-una-stringa-lunga-e-casuale

# Quale database usare: 'sqlite' oppure 'supabase'
DB_DRIVER=sqlite

# --- se DB_DRIVER=sqlite ---
SQLITE_FILE=./data/app.db

# --- se DB_DRIVER=supabase ---
# URL e chiavi si trovano nella dashboard, in Project Settings > API
SUPABASE_URL=
# chiave pubblica: puo' arrivare al browser, e' limitata dalle RLS
SUPABASE_ANON_KEY=
# chiave privata: SCAVALCA LE RLS. Solo backend, mai nel frontend, mai su git.
SUPABASE_SERVICE_KEY=

# AI: 'mock' non chiama nessuna API e non costa niente.
# Alternative: 'openai' | 'anthropic'
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=

# n8n: lascia vuoto e i workflow vengono simulati.
N8N_WEBHOOK_URL=

# Email: lascia SMTP_HOST vuoto e le email vengono solo scritte nel log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@gamefollow.app

# Rate limiting sull'accesso (vedi src/middleware/rateLimit.js)
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_API_WINDOW_MS=900000
RATE_LIMIT_API_MAX=300

# 'production' attiva i cookie di sessione "secure" (solo HTTPS)
NODE_ENV=development
# metti a 1 solo se il server sta dietro un reverse proxy (nginx, Render...)
TRUST_PROXY=0

# Stripe: dashboard.stripe.com -> Developers -> API keys (usa le chiavi "test"
# finche' non sei pronto a incassare per davvero — servono comunque una
# volta aperta la P.IVA, prima no).
STRIPE_SECRET_KEY=
# dashboard.stripe.com -> Developers -> Webhooks (o dalla CLI: stripe listen)
STRIPE_WEBHOOK_SECRET=
# Product -> Pricing: crea un Price ricorrente mensile per ciascun piano e
# incolla qui il suo id (price_...). Un piano senza id qui non e' acquistabile.
STRIPE_PRICE_INDIE=
STRIPE_PRICE_STUDIO=
STRIPE_PRICE_PUBLISHER=

# URL pubblico dell'app: Stripe Checkout torna qui dopo il pagamento.
APP_URL=http://localhost:3000
